---
- name: Configure monitoring agents
  hosts: agents
  become: true

  vars:
    package_list: 
      - python3
      - python3-pip
  tasks:
    - name: Install Python and pip
      ansible.builtin.apt:
        name: "{{ package_list }}"
        state: present
        update_cache: true
    - name: Create folder
      ansible.builtin.file:
        path: /opt/monitoring-agent
        state: directory
        mode: '0755'
    - name: Copy agents
      ansible.builtin.copy:
        src: ../agent/agent.py
        dest: /opt/monitoring-agent/agent.py
        owner: "{{ansible_user}}"
        group: "{{ansible_user}}"
        